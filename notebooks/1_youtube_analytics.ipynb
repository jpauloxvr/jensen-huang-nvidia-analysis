   "id": "0ecf5705",
   "metadata": {},
   "outputs": [],
   "source": [
    "from googleapiclient.discovery import build\n",
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "API_KEY = \"PASTE_YOUR_KEY_HERE"\n",
    "youtube = build(\"youtube\", \"v3\", developerKey=API_KEY)\n",
    "\n",
    "termos = ['\"Jensen Huang\"', '#bringjensenback', '\"Jensen Huang\" NVIDIA']\n",
    "video_ids = set()\n",
    "\n",
    "# 1. Busca os IDs dos vídeos publicados desde 15/10/2026\n",
    "for termo in termos:\n",
    "    next_page_token = None\n",
    "    for _ in range(2):  # Até 2 páginas (100 vídeos) por termo\n",
    "        req = youtube.search().list(\n",
    "            part=\"id\",\n",
    "            q=termo,\n",
    "            type=\"video\",\n",
    "            publishedAfter=\"2026-10-15T00:00:00Z\",\n",
    "            maxResults=50,\n",
    "            pageToken=next_page_token\n",
    "        )\n",
    "        res = req.execute()\n",
    "        for item in res.get(\"items\", []):\n",
    "            video_ids.add(item[\"id\"][\"videoId\"])\n",
    "        next_page_token = res.get(\"nextPageToken\")\n",
    "        if not next_page_token:\n",
    "            break\n",
    "\n",
    "#Coleta título, canal, data e estatísticas em lotes de 50\n",
    "lista_ids = list(video_ids)\n",
    "videos = []\n",
    "\n",
    "for i in range(0, len(lista_ids), 50):\n",
    "    lote = \",\".join(lista_ids[i:i+50])\n",
    "    stats_res = youtube.videos().list(\n",
    "        part=\"snippet,statistics\",\n",
    "        id=lote\n",
    "    ).execute()\n",
    "\n",
    "    for v in stats_res.get(\"items\", []):\n",
    "        snip = v[\"snippet\"]\n",
    "        stats = v.get(\"statistics\", {})\n",
    "        videos.append({\n",
    "            \"data\": snip[\"publishedAt\"][:10],\n",
    "            \"visualizacoes\": int(stats.get(\"viewCount\", 0)),\n",
    "            \"curtidas\": int(stats.get(\"likeCount\", 0)),\n",
    "            \"comentarios\": int(stats.get(\"commentCount\", 0))\n",
    "        })\n",
    "\n",
    "df_youtube = pd.DataFrame(videos)\n",
    "os.makedirs(\"../data/processed\", exist_ok=True)\n",
    "df_youtube.to_csv(\"../data/processed/repercussao_youtube_jensen.csv\", index=False)\n",
    "print(f\"Vídeos únicos coletados: {len(df_youtube)}\")"
   ]
  },
